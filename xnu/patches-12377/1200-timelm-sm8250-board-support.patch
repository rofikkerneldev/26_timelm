diff --git a/bsd/dev/sweet_board.h b/bsd/dev/sweet_board.h
index 3d9c06a..f974c63 100644
--- a/bsd/dev/sweet_board.h
+++ b/bsd/dev/sweet_board.h
@@ -1,8 +1,12 @@
 /*
- * SWEET kernels run on two Xiaomi phones. The ADT root compatible
+ * SWEET kernels run on three phones. The ADT root compatible
  * (tools/mkadt.py --board) names the board; everything else is common.
  *   xiaomi,sweet      Redmi Note 10 Pro, SM7150 (default)
  *   xiaomi,beryllium  Poco F1, SDM845
+ *   lg,timelm         LG V60 ThinQ (timelm), SM8250: ARMv8.2 like the
+ *                     others, but Aff0 = core, Aff1 = 0 (kona numbering),
+ *                     virtual timer INTID 27 (the ADT records it), EPSS
+ *                     cpufreq with three domains (Silver/Gold/Prime).
  */
 #ifndef _SWEET_BOARD_H_
 #define _SWEET_BOARD_H_
@@ -76,4 +80,14 @@ sweet_board_beryllium(void)
 	return cached == 1;
 }
 
+static inline bool
+sweet_board_timelm(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		cached = sweet_board_is("lg,timelm") ? 1 : 0;
+	}
+	return cached == 1;
+}
+
 #endif /* _SWEET_BOARD_H_ */
